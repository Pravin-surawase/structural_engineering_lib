# Environment Variables for Structural Engineering API
# =====================================================
# Copy to .env and configure for your environment:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =====================================================

# Deployment Profile
# ------------------
# Keep development for direct local evaluation. docker-compose.yml sets this to
# production and refuses to start unless authentication has a non-default secret.
ENVIRONMENT=development
HOST=127.0.0.1

# JWT Authentication
# ------------------
# Secret key for signing JWT tokens
# IMPORTANT: Set a strong, non-default value in production!
JWT_SECRET_KEY=change-me-in-production

# Rate Limiting
# -------------
# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Window duration in seconds
RATE_LIMIT_WINDOW=60

# Authentication
# ---------------
# Local development can remain unauthenticated. docker-compose.yml forces true.
AUTH_ENABLED=false
WORKFLOW_RUNNER_ENABLED=false

# ETABS Live Bridge
# -----------------
# Disabled routes are not mounted and do not appear in OpenAPI. Enabling the
# read/attach bridge requires HOST=127.0.0.1 (or another loopback address),
# AUTH_ENABLED=true, a non-default JWT secret, and the etabs:live:read scope.
# Mutation is a separate opt-in and requires the etabs:live:mutate scope.
ETABS_LIVE_BRIDGE_ENABLED=false
ETABS_LIVE_MUTATION_ENABLED=false

# CORS Origins (comma-separated)
# --------------------------------
# CORS_ORIGINS=["https://your-domain.com"]

# Optional: Development/Debug
# ---------------------------
# LOG_LEVEL=INFO
# DEBUG=false
