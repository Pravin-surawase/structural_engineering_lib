# API Configuration
# Copy to .env.local and customize

# Leave commented for local/SSH dev (uses Vite proxy — recommended)
# Set for Docker/production:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000

# Development/test-only bounded beam workflow. The React route also requires
# Vite development mode, and the backend separately requires
# WORKFLOW_RUNNER_ENABLED=true.
VITE_WORKFLOW_RUNNER_ENABLED=false
