    <ProjectReference Include="../StructuralEngineering.Analysis/StructuralEngineering.Analysis.csproj" />
    <ProjectReference Include="../StructuralEngineering.Construction/StructuralEngineering.Construction.csproj" />
    <ProjectReference Include="../StructuralEngineering.Optimization/StructuralEngineering.Optimization.csproj" />
    <ProjectReference Include="../StructuralEngineering.Reporting/StructuralEngineering.Reporting.csproj" />
    <PackageReference Include="ExcelDna.AddIn" />
  </ItemGroup>
