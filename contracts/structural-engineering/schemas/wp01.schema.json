{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-engineering.dev/schemas/wp01/v1",
  "title": "WP01 portable requests",
  "$defs": {
    "barPosition": {
      "type": "object",
      "required": ["bar_id", "diameter_mm", "x_from_left_mm", "y_from_top_mm", "face", "layer"],
      "properties": {
        "bar_id": {"type": "string", "minLength": 1},
        "diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "x_from_left_mm": {"type": "number"},
        "y_from_top_mm": {"type": "number"},
        "face": {"enum": ["top", "bottom"]},
        "layer": {"type": "integer", "minimum": 1}
      }
    },
    "geometryRequest": {
      "type": "object",
      "required": ["profile_id", "width_mm", "depth_mm", "nominal_cover_mm", "link_diameter_mm", "minimum_clear_spacing_mm", "bars", "code_data_revision_id"],
      "properties": {
        "profile_id": {"type": "string"},
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "depth_mm": {"type": "number", "exclusiveMinimum": 0},
        "nominal_cover_mm": {"type": "number", "minimum": 0},
        "link_diameter_mm": {"type": "number", "minimum": 0},
        "minimum_clear_spacing_mm": {"type": "number", "minimum": 0},
        "bars": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/barPosition"}},
        "code_data_revision_id": {"type": "string"}
      }
    },
    "capacityRequest": {
      "type": "object",
      "required": ["profile_id", "section_kind", "web_width_mm", "depth_mm", "concrete_strength_n_per_mm2", "steel_yield_strength_n_per_mm2", "bars", "tension_face", "axial_force_kn", "code_data_revision_id"],
      "properties": {
        "profile_id": {"type": "string"},
        "section_kind": {"enum": ["rectangular", "t_beam", "l_beam"]},
        "web_width_mm": {"type": "number", "exclusiveMinimum": 0},
        "depth_mm": {"type": "number", "exclusiveMinimum": 0},
        "concrete_strength_n_per_mm2": {"type": "number", "exclusiveMinimum": 0},
        "steel_yield_strength_n_per_mm2": {"type": "number", "minimum": 250, "maximum": 550},
        "bars": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/barPosition"}},
        "tension_face": {"enum": ["top", "bottom"]},
        "flange_width_mm": {"type": ["number", "null"]},
        "flange_thickness_mm": {"type": ["number", "null"]},
        "axial_force_kn": {"type": "number"},
        "code_data_revision_id": {"type": "string"}
      }
    }
  }
}
