        {"name": "concrete_net_segments_and_overlap_policy", "unit": "mm2/mm/m3"},
        {"name": "formwork_contact_faces_and_measurement_policy", "unit": "mm2"}
      ],
      "outputs": [
        {"name": "steel/concrete/formwork items", "unit": "kg/m3/m2"},
        {"name": "kerf/reusable offcut/unreusable waste ledger", "unit": "mm"},
        {"name": "direct_cost", "unit": "null until AO20"}
      ],
      "python_projection": "structural_lib.construction.calculate_construction_quantities",
      "dotnet_projection": "StructuralEngineering.Construction.QuantityOperations.Calculate",
      "valid_example": "wp07-reference-quantities",
      "non_success_example": "wp07-duplicate-concrete-ownership"
    },
    {
      "catalogue_id": "AO19",
      "semantic_id": "structural.bbs.create/v1",
