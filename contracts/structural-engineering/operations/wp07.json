        {"name": "stock_and_cutting_policy", "unit": "mm/versioned policy"},
        {"name": "splice_and_link_zone_records", "unit": "typed physical records"}
      ],
      "outputs": [
        {"name": "BBS rows and link stations", "unit": "count/mm/kg"},
        {"name": "stock cuts, kerf, reusable offcuts, waste", "unit": "mm/kg"},
        {"name": "allocation_optimality", "unit": "declared algorithm status"}
      ],
      "python_projection": "structural_lib.construction.create_bbs",
      "dotnet_projection": "StructuralEngineering.Construction.BbsOperations.Create",
      "valid_example": "wp07-cutting-reconciliation",
      "non_success_example": "wp07-link-boundary-duplicate"
    },
    {
      "catalogue_id": "AO20",
      "semantic_id": "structural.construction_cost.estimate/v1",
