      "outputs": [
        {"name": "itemized cost lines", "unit": "currency decimal"},
        {"name": "direct/overhead/pre-tax/tax/total", "unit": "currency decimal"}
      ],
      "python_projection": "structural_lib.construction.estimate_construction_cost",
      "dotnet_projection": "StructuralEngineering.Construction.CostOperations.Estimate",
      "valid_example": "wp07-dated-direct-cost",
      "non_success_example": "wp07-cost-waste-double-count"
