{
  "schema_version": 1,
  "task_id": "BEAM-DATA-REQUIREMENTS",
  "source_commit": "e027750485d5e40c509df4a1119dd7705fd2d5e6",
  "audit_date": "2026-09-10",
  "method": "Static main-process call-chain, source contracts, existing test definitions and maintained programme plans; no new tests or live ETABS/Excel calls.",
  "conclusion": "Editable assumptions exist, but the baseline numerical request is populated from Design Inputs. Assumptions revision checking is not numerical-value propagation. Common preset resolution and downstream integration remain implementation work.",
  "observations": [
    {
      "id": "INPUT-01",
      "status": "confirmed",
      "finding": "Assumptions exposes twenty preset-derived explicit-value cells. Reuse reads existing sheets; save retains workbook values. Choice fields admit only their preset values."
    },
    {
      "id": "INPUT-02",
      "status": "confirmed_gap",
      "finding": "AcceptDesignInputs serializes input.Inputs from ReadDesignInputs; ReadAssumptions contributes a separate accepted revision. A cover-only Assumptions edit invalidates the result without replacing Design Inputs nominal_cover_mm. Reacceptance does not bridge those values.",
      "root_cause": "Independent workbook input owners without a common effective-value resolver.",
      "resolution_status": "Planned C0a/C0b root-cause repair; no runtime change in this audit."
    },
    {
      "id": "INPUT-03",
      "status": "confirmed_gap",
      "finding": "BaselineInputSheet.Create embeds catalogue seed literals distinct from demo-beam-preset.json; longitudinal choices and stock lengths differ.",
      "root_cause": "Independent catalogue initialization path.",
      "resolution_status": "Consolidate editable seed authority and scoped overrides in the same resolver packet."
    },
    {
      "id": "INPUT-04",
      "status": "confirmed_boundary",
      "finding": "SnapshotMaterial has elastic properties and density, not design strengths. The baseline requires material-ID strength/modulus mappings, member support/context/fire/restraint evidence and ULS/total-SLS/sustained-SLS roles."
    },
    {
      "id": "INPUT-05",
      "status": "confirmed_boundary",
      "finding": "The preset fire duration is 60 minutes; current baseline only supports an explicit NotRequired fire decision with null duration. Required fire design must not be silently removed."
    },
    {
      "id": "INPUT-06",
      "status": "confirmed_boundary",
      "finding": "Section options, cost rates and JSON automation settings do not imply a baseline-design or integrated optimization consumer. Current serviceability uses span/depth screening and bounded crack calculations."
    }
  ],
