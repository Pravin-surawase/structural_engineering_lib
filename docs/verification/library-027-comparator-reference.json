  "conventions": {
    "units": "mm; N/mm²; kN; kN·m; percent (not fraction)",
    "depth": "y and xu measured from the nominated top compression face",
    "force": "Compression positive. Beams solve zero net axial force; column evaluates fixed xu.",
    "moment": "Sum compression-positive force times (D/2 − y). Positive beam sagging or positive about the column's nominated horizontal centroidal axis. Transverse column moment is outside the comparator.",
    "shear": "Vertical shear; use web width for flanged shear and area-weighted centroid of the bottom steel for d.",
    "cover": "25 mm for beams and 35 mm for the column are context from quickstart. Preserve supplied depths; cover and illustrative lateral coordinates are not detailing evidence.",
    "lateral_coordinates": "If the StructLib API requires them, space centers in each layer at b*(i+1)/(count+1) from left (i is zero-based); for column subtract b/2 for centroidal transverse coordinates. In-plane references do not depend on these placeholders."
  },
  "methods": {
    "rcdesign": "Fig. 21 integrated beam concrete, representative Fig. 23A steel and net compression bar force; comparator continuous concrete shear formula and fy/1.15 vertical links.",
