  "confirmed_findings": [
    {
      "id": "COM-TARGET-001",
      "priority": "P0",
      "finding": "The current Python live bridge and legacy VBA attach without a PID and can target an ambiguous running ETABS instance."
    },
    {
      "id": "COM-STATE-002",
      "priority": "P0",
      "finding": "The current Python pilot changes result output selection without restoring the predecessor selection."
    },
    {
      "id": "BEAM-FACE-003",
      "priority": "P0",
      "finding": "The current live pilot converts governing M3 to magnitude and omits primary_tension_face, bypassing the signed-face repair accepted in PR 940."
    },
    {
      "id": "OPT-PARITY-004",
      "priority": "P0",
      "finding": "Bar, cost and Pareto optimizers use different feasibility paths; multi-layer recommendations do not carry exact layer distribution and effective-depth proof."
    },
    {
      "id": "DESIGN-BASIS-005",
      "priority": "P1",
      "finding": "Legacy beam and column result reads do not bind design code, preferences, overwrites, object design procedure and section rebar definition into one comparison snapshot."
    },
    {
      "id": "MUTATION-TXN-006",
      "priority": "P1",
      "finding": "Legacy frame section updates lack PID/model binding, expected-old validation, per-object readback, complete rollback and owned-process isolation."
    },
    {
      "id": "ACQUISITION-007",
      "priority": "P1",
      "finding": "The broad W3H table COM route is closed for this model and host; named missing fields should use saved evidence, proved getters or ETABS 23.3 SQLite export."
    },
    {
      "id": "SOLVER-SCOPE-008",
      "priority": "P2",
      "finding": "Support, mesh and slab-transfer basis remains incomplete, so a general solver extension would not by itself make the saved candidates comparable."
    }
  ],
  "decisions": [
    "Add PID-specific session discovery and connection contracts before any new live pilot.",
    "Add a complete state guard and raw-call ledger before strict COM decoding.",
    "Deprecate the pilot calculation owner and compose the canonical W3 audit.",
    "Use one layer-aware candidate evaluator for bar, cost and Pareto ranking.",
    "Use a matched-basis read-only ETABS design snapshot for comparison.",
    "Use named SQLite acquisition before any reconsideration of broad table COM calls.",
    "Allow setters only in an owned ETABS process operating on a hash-bound copy.",
    "Keep ETABS as global analysis authority and the existing local solver bounded."
  ],
