    {
      "id": "PF3-D2-responsibility-matrix",
      "dependency_direction": "core quantities/contracts -> design-code calculations -> reusable services -> application adapters",
      "records": [
        {"owner": "core", "may_contain": ["quantities", "geometry", "materials", "identity primitives", "diagnostics"], "forbidden": ["IS 456 rules", "Excel", "ETABS", "file rendering"]},
        {"owner": "codes.is456", "may_contain": ["pure code formulas", "normalized lookups", "applicability", "rule provenance"], "forbidden": ["workbook cells", "COM objects", "HTTP", "file paths", "model sessions"]},
        {"owner": "services", "may_contain": ["member orchestration", "analysis snapshots", "bar resolution", "BBS data", "quantities", "search", "calculation records"], "forbidden": ["required running host", "duplicated formulas in adapters"]},
        {"owner": "adapters.excel", "may_contain": ["range conversion", "UDF registration", "ribbon/panel commands", "bulk workbook I/O"], "forbidden": ["independent engineering formulas", "live ETABS calls during recalculation"]},
        {"owner": "adapters.etabs", "may_contain": ["CSI interop", "return/array validation", "selection/unit restoration", "model-copy commands"], "forbidden": ["design-code formulas", "worksheet dependencies"]},
        {"owner": "presentation", "may_contain": ["HTML/PDF/DXF/workbook rendering"], "forbidden": ["recalculation of engineering quantities"]},
        {"owner": "compatibility", "may_contain": ["old-name/shape translation", "deprecation diagnostics"], "forbidden": ["silent legacy semantics", "new engineering defaults"]}
      ]
    },
    {
      "id": "PF3-D3-supported-profiles",
      "profiles": [
        {"id": "PROFILE-FOUNDATION-V1", "scope": "explicit quantities, material/bar catalogues, section/support geometry, actual bar coordinates and vendor-neutral action records", "initial": true},
        {"id": "PROFILE-BEAM-LINE-PLANAR-V1", "scope": "linear Euler-Bernoulli planar bending over ordered prismatic elements with declared supports, springs, settlements, UDL and nodal actions", "initial": true, "limits": ["no global-building effects", "no shear deformation", "no material/geometric nonlinearity", "no hidden self weight"]},
        {"id": "PROFILE-RC-SECTION-IS456-V1", "scope": "ordinary rectangular singly/doubly reinforced and eligible T/L sections, both bending signs, relevant shear and torsion checks using declared concurrent action semantics", "initial": true, "limits": ["nonzero axial/minor-axis interaction requires a separately supported method", "flange eligibility and compression-zone assumptions are explicit"]},
        {"id": "PROFILE-RC-BEAM-MEMBER-IS456-V1", "scope": "one or more collinear spans with physical support faces, positive/negative regions, ULS and SLS actions, complete flexure/shear/torsion/SLS/detailing/fit checks, resolved reinforcement and construction data", "initial": true, "limits": ["required-check profile is versioned", "all stations/discontinuity sides needed by the checks are present"]},
        {"id": "PROFILE-RC-BEAM-SEISMIC-DETAIL-V1", "scope": "ordinary beam member plus selected system/joint/capacity-design context, continuity, confinement, hook and splice requirements", "initial": "after ordinary member slice", "limits": ["geometry-only seismic checks are insufficient"]},
        {"id": "PROFILE-RC-BEAM-ETABS-V1", "scope": "the ordinary/seismic member profile fed by an identified immutable ETABS snapshot and controlled copied-model reanalysis", "initial": "after standalone Excel workflow", "limits": ["supported installed ETABS/runtime matrix is set in PF9"]}
      ],
      "explicit_exclusions": [
        {"scope": "deep, curved, prestressed, post-tensioned, hollow, composite and other special beams", "reason": "need separate analysis/design profiles and assurance", "decision_owner": "ROLE-ENGINEERING"},
        {"scope": "full 2D/3D frame, diaphragm, wall, slab, foundation or soil-structure analysis", "reason": "outside bounded beam analysis and first product", "decision_owner": "ROLE-PRODUCT"},
        {"scope": "other code families and automatic parity for existing non-beam Python APIs", "reason": "require separately approved common-set extension", "decision_owner": "ROLE-PRODUCT"},
        {"scope": "temporary-works design of formwork systems", "reason": "CAP-FORMWORK measures contact area only", "decision_owner": "ROLE-ENGINEERING"},
        {"scope": "professional approval generated by software", "reason": "approval is a human recorded action", "decision_owner": "ROLE-ENGINEERING"}
      ]
    },
