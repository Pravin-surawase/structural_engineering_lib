  "deliverables": [
    {
      "id": "PF11-D1-integrated-baseline",
      "architecture_invariants": [
        {
          "id": "INV-01",
          "rule": "Python and .NET implement the deliberate common semantic operation set natively; parity means equivalent canonical inputs, states, provenance and independently qualified values, not shared source code."
        },
        {
          "id": "INV-02",
          "rule": "Dependencies flow from contracts/core to code rules, reusable services and then application adapters; no pure package imports Excel, ETABS, UI, web server or renderer state."
        },
        {
          "id": "INV-03",
          "rule": "Quantities, units, signs, axes, stations, action concurrency, optional values and identities follow PF4 in every language and adapter."
        },
        {
          "id": "INV-04",
          "rule": "Value, capacity, check, design, member service, adapter command and human approval remain different public operations/records."
        },
        {
          "id": "INV-05",
          "rule": "Every result returns effective inputs, independent execution/applicability/engineering/completeness/freshness/approval dimensions, diagnostics, provenance and calculation identity."
        },
        {
          "id": "INV-06",
          "rule": "Every required member leaf is frozen before evaluation and retained after it; required not_applicable, not_evaluated, stale or missing leaves cannot qualify or be ranked."
        },
        {
          "id": "INV-07",
          "rule": "Selected and scheduled reinforcement are actual arrangements with coordinates and paths; BBS, steel mass, formwork, cost and reports derive from the same current detail identity."
        },
        {
          "id": "INV-08",
          "rule": "Worksheet functions are pure over immutable inputs. Workbook writes, long design/search, ETABS access, file rendering and approval records are explicit commands."
        },
        {
          "id": "INV-09",
          "rule": "ETABS rows retain model/analysis/result/case/step/object/element/station/axis and same-row P/V2/V3/T/M2/M3; component envelopes do not become concurrent vectors."
        },
        {
          "id": "INV-10",
          "rule": "Only reinforcement/detail/cost/report changes may reuse fixed actions. Structural-response changes require an identified model copy, readback, reanalysis, new snapshot and comparison."
        },
        {
          "id": "INV-11",
          "rule": "Engineering claims require PF7 independent evidence; Python/.NET agreement is correlation and installed Excel/ETABS claims require PF8 E5 evidence."
        },
        {
          "id": "INV-12",
          "rule": "Package, semantic operation, schema, profile, code-data, corpus, workbook, adapter and report-template versions remain separately visible and replayable."
        },
        {
          "id": "INV-13",
          "rule": "Compatibility wrappers expose translation and refuse unresolved unsafe ambiguity; existing non-beam Python users retain their current supported route."
        },
        {
          "id": "INV-14",
          "rule": "Performance claims bind frozen workloads, exact artifacts/environments, correctness results and raw median/p95 samples; language choice alone proves no speedup."
        },
        {
          "id": "INV-15",
          "rule": "Software records prepared/checked/approved people and scope but never creates professional engineering approval or release authorization."
        }
      ],
      "authoritative_future_paths": [
        {
          "path": "contracts/structural-engineering/operations",
          "owns": "semantic operation manifests and projection maps"
        },
        {
          "path": "contracts/structural-engineering/schemas",
          "owns": "portable interchange JSON Schemas"
        },
        {
          "path": "contracts/structural-engineering/code-data",
          "owns": "normalized design-code data and provenance"
        },
        {
          "path": "contracts/structural-engineering/conformance",
          "owns": "independent expected examples and cross-language vectors"
        },
        {
          "path": "Python/structural_lib",
          "owns": "native Python implementation and compatibility"
        },
        {
          "path": "CSharp/src/StructuralEngineering.*",
          "owns": "native .NET implementation and Windows adapters"
        },
        {
          "path": "docs/library",
          "owns": "concept, API, cookbook, application, assurance and migration documentation"
        }
      ],
      "definition_status": "PF0-PF11 planning complete. This baseline is ready to drive implementation when the owner starts an implementation packet; it is not itself implementation, installed acceptance, engineering approval or release permission."
    },
