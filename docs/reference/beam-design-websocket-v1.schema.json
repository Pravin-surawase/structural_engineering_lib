        },
        "amendment_applicability_review_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amendment Applicability Review Id"
        },
        "artifact_schema": {
          "title": "Artifact Schema",
          "type": "string"
        },
        "artifact_schema_version": {
          "title": "Artifact Schema Version",
          "type": "string"
        },
        "calculation_identity": {
          "title": "Calculation Identity",
          "type": "string"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "code_amendment_identity": {
          "title": "Code Amendment Identity",
          "type": "string"
        },
        "code_edition": {
          "title": "Code Edition",
          "type": "string"
        },
        "controlled_source_basis_hash": {
          "title": "Controlled Source Basis Hash",
