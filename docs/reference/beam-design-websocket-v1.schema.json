{
  "$defs": {
    "BeamDesignResponse": {
      "description": "Response model for beam design calculation.",
      "properties": {
        "asc_total": {
          "default": 0.0,
          "description": "Total compression steel (mm\u00b2)",
          "title": "Asc Total",
          "type": "number"
        },
        "ast_total": {
          "description": "Total tension steel required (mm\u00b2)",
          "title": "Ast Total",
          "type": "number"
        },
        "combined_actions": {
          "anyOf": [
            {
              "$ref": "#/$defs/CombinedBeamActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crack_width_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrackWidthCheckResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deflection_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeflectionCheckResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_depth_basis": {
          "$ref": "#/$defs/EffectiveDepthResolutionResponse"
        },
        "effective_depth_used": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual effective depth used in calculation (mm)",
          "title": "Effective Depth Used"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceEnvelopeResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Traceable calculation identity and supported-case boundary"
        },
        "flexure": {
          "$ref": "#/$defs/FlexureResult"
        },
        "governing_utilization": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact dimensionless governing compliance ratio, without a display cap. Null means not evaluated; inspect unavailable_utilizations.",
          "title": "Governing Utilization"
        },
        "holds": {
          "items": {
            "type": "string"
          },
          "title": "Holds",
          "type": "array"
        },
        "message": {
          "description": "Summary message",
          "title": "Message",
          "type": "string"
        },
        "result_envelope": {
          "$ref": "#/$defs/StructuralResultEnvelopeResponse"
        },
        "shear": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShearResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "success": {
          "description": "Compatibility engineering boolean; use result_envelope for the canonical PASS, FAIL, or HOLD disposition",
          "title": "Success",
          "type": "boolean"
        },
        "torsion": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegratedTorsionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unavailable_utilizations": {
          "additionalProperties": {
            "$ref": "#/$defs/UnavailableUtilization"
          },
          "description": "Core-owned utilization paths and explicit unavailable reasons. governing_utilization identifies a missing exact governing ratio.",
          "title": "Unavailable Utilizations",
          "type": "object"
        },
        "utilization_ratio": {
          "deprecated": true,
          "description": "Deprecated compatibility display ratio capped at 2.0; not the exact engineering ratio. Use governing_utilization and result_envelope.",
          "maximum": 2.0,
          "minimum": 0,
          "title": "Utilization Ratio",
          "type": "number"
        },
        "warnings": {
          "description": "Design warnings",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "success",
        "message",
        "flexure",
        "ast_total",
        "utilization_ratio",
        "effective_depth_basis",
        "result_envelope"
      ],
      "title": "BeamDesignResponse",
      "type": "object"
    },
    "CombinedBeamActions": {
      "description": "Original and IS 456 equivalent actions used by the primary route.",
      "properties": {
        "me_knm": {
          "title": "Me Knm",
          "type": "number"
        },
        "mu_knm": {
          "title": "Mu Knm",
          "type": "number"
        },
        "tu_knm": {
          "title": "Tu Knm",
          "type": "number"
        },
        "ve_kn": {
          "title": "Ve Kn",
          "type": "number"
        },
        "vu_kn": {
          "title": "Vu Kn",
          "type": "number"
        }
      },
      "required": [
        "mu_knm",
        "vu_kn",
        "tu_knm",
        "me_knm",
        "ve_kn"
      ],
      "title": "CombinedBeamActions",
      "type": "object"
    },
    "CrackWidthCheckResult": {
      "description": "Result of crack width check.",
      "properties": {
        "crack_width_limit_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crack Width Limit Mm"
        },
        "crack_width_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crack Width Mm"
        },
        "is_ok": {
          "title": "Is Ok",
          "type": "boolean"
        },
        "remarks": {
          "default": "",
          "title": "Remarks",
          "type": "string"
        }
      },
      "required": [
        "is_ok"
      ],
      "title": "CrackWidthCheckResult",
      "type": "object"
    },
    "DeflectionCheckResult": {
      "description": "Result of deflection span/depth check.",
      "properties": {
        "is_ok": {
          "title": "Is Ok",
          "type": "boolean"
        },
        "remarks": {
          "default": "",
          "title": "Remarks",
          "type": "string"
        },
        "span_depth_actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Depth Actual"
        },
        "span_depth_allowable": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Depth Allowable"
        }
      },
      "required": [
        "is_ok"
      ],
      "title": "DeflectionCheckResult",
      "type": "object"
    },
    "EffectiveDepthBasisResponse": {
      "description": "Complete geometry basis used to derive beam effective depth.",
      "properties": {
        "clear_cover_mm": {
          "title": "Clear Cover Mm",
          "type": "number"
        },
        "stirrup_diameter_mm": {
          "title": "Stirrup Diameter Mm",
          "type": "number"
        },
        "tension_bar_diameter_mm": {
          "title": "Tension Bar Diameter Mm",
          "type": "number"
        }
      },
      "required": [
        "clear_cover_mm",
        "stirrup_diameter_mm",
        "tension_bar_diameter_mm"
      ],
      "title": "EffectiveDepthBasisResponse",
      "type": "object"
    },
    "EffectiveDepthResolutionResponse": {
      "description": "Explicit record of the effective depth consumed by the calculation.",
      "properties": {
        "D_mm": {
          "title": "D Mm",
          "type": "number"
        },
        "contract_version": {
          "const": "effective-depth-basis/v1",
          "title": "Contract Version",
          "type": "string"
        },
        "d_mm": {
          "title": "D Mm",
          "type": "number"
        },
        "effective_depth_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectiveDepthBasisResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "enum": [
            "EXPLICIT",
            "DERIVED"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "source",
        "D_mm",
        "d_mm"
      ],
      "title": "EffectiveDepthResolutionResponse",
      "type": "object"
    },
    "EvidenceEnvelopeResponse": {
      "description": "Traceable identity metadata, not a professional approval certificate.",
