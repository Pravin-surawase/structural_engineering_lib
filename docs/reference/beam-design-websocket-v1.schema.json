      "required": [
        "ast_required",
        "ast_min",
        "ast_max",
        "xu",
        "xu_max",
        "is_under_reinforced",
        "moment_capacity"
      ],
      "title": "FlexureResult",
      "type": "object"
    },
    "IntegratedTorsionResult": {
      "description": "Torsion calculation details embedded in the primary beam result.",
      "properties": {
        "al_torsion": {
          "description": "Total Me1/Me2 tension steel (mm\u00b2), not additive to flexure",
