        },
        "explicit_units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Explicit Units",
          "type": "object"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "governing_check": {
          "title": "Governing Check",
          "type": "string"
        },
        "library_content_identity": {
          "title": "Library Content Identity",
          "type": "string"
        },
        "library_version": {
          "title": "Library Version",
          "type": "string"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Margin"
        },
        "normalized_input_hash": {
          "title": "Normalized Input Hash",
          "type": "string"
        },
        "provenance_hash": {
          "title": "Provenance Hash",
          "type": "string"
        },
        "qualified_review_required": {
          "title": "Qualified Review Required",
          "type": "boolean"
        },
        "qualified_review_requirement": {
          "title": "Qualified Review Requirement",
          "type": "string"
        },
        "replay_receipt": {
          "additionalProperties": true,
          "title": "Replay Receipt",
          "type": "object"
        },
        "replay_receipt_hash": {
          "title": "Replay Receipt Hash",
          "type": "string"
        },
        "source_metadata": {
          "additionalProperties": true,
          "title": "Source Metadata",
          "type": "object"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "HOLD"
          ],
          "title": "Status",
          "type": "string"
        },
        "support_status": {
          "enum": [
            "SUPPORTED",
            "HELD"
          ],
          "title": "Support Status",
          "type": "string"
        },
        "unit_system": {
          "title": "Unit System",
          "type": "string"
        },
        "utilization_disposition": {
          "enum": [
            "FINITE",
            "UNBOUNDED_FAILURE",
            "NOT_EVALUATED"
          ],
          "title": "Utilization Disposition",
          "type": "string"
        }
      },
      "required": [
        "artifact_schema",
        "artifact_schema_version",
        "library_version",
        "library_content_identity",
        "code_edition",
        "code_amendment_identity",
        "amendment_applicability",
        "amendment_applicability_review_id",
        "controlled_source_ids",
        "controlled_source_basis_hash",
        "capability_id",
        "support_status",
        "unit_system",
        "explicit_units",
        "normalized_input_hash",
        "provenance_hash",
        "source_metadata",
        "calculation_identity",
        "replay_receipt",
        "replay_receipt_hash",
        "governing_check",
        "exact_utilization",
        "utilization_disposition",
        "margin",
        "status",
        "generated_at",
        "qualified_review_required",
        "qualified_review_requirement"
      ],
      "title": "EvidenceEnvelopeResponse",
      "type": "object"
    },
    "FlexureResult": {
      "description": "Flexure design result.",
      "properties": {
        "asc_required": {
          "default": 0.0,
          "description": "Compression steel if needed (mm\u00b2)",
          "title": "Asc Required",
          "type": "number"
        },
        "ast_max": {
          "description": "Maximum allowed steel area (mm\u00b2)",
          "title": "Ast Max",
          "type": "number"
        },
        "ast_min": {
          "description": "Minimum required steel area (mm\u00b2)",
          "title": "Ast Min",
          "type": "number"
        },
        "ast_required": {
          "description": "Required tension steel area (mm\u00b2)",
          "title": "Ast Required",
          "type": "number"
        },
        "is_under_reinforced": {
          "description": "Whether section is under-reinforced",
          "title": "Is Under Reinforced",
          "type": "boolean"
        },
        "moment_capacity": {
          "description": "Singly reinforced limiting moment Mu,lim (kN\u00b7m)",
          "title": "Moment Capacity",
          "type": "number"
        },
        "xu": {
          "description": "Neutral axis depth (mm)",
          "title": "Xu",
          "type": "number"
        },
        "xu_max": {
          "description": "Limiting neutral axis depth (mm)",
          "title": "Xu Max",
          "type": "number"
        }
