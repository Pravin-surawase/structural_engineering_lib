    "StructuralResultEnvelopeResponse": {
      "description": "Transport model of the canonical structural-result envelope.",
      "properties": {
        "calculation_status": {
          "enum": [
            "NOT_EVALUATED",
            "COMPLETED",
            "ERROR"
          ],
          "title": "Calculation Status",
          "type": "string"
        },
        "engineering_status": {
          "enum": [
            "NOT_EVALUATED",
            "PASS",
            "FAIL",
            "HOLD"
          ],
          "title": "Engineering Status",
          "type": "string"
        },
        "freshness_status": {
          "enum": [
            "CURRENT",
            "STALE"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "intake_status": {
          "enum": [
            "VALID",
            "PARTIAL",
            "BLOCKED"
          ],
          "title": "Intake Status",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/StructuralIssueResponse"
          },
          "title": "Issues",
          "type": "array"
        },
        "overall_status": {
          "enum": [
            "BLOCKED",
            "ERROR",
            "NOT_EVALUATED",
            "STALE",
            "PASS",
            "FAIL",
            "HOLD"
          ],
          "title": "Overall Status",
          "type": "string"
        },
        "qualified_review_required": {
          "title": "Qualified Review Required",
          "type": "boolean"
        },
        "result_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultIdentityResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_status": {
          "enum": [
            "QUALIFIED_REVIEW_REQUIRED",
            "REVIEWED_ACCEPTED",
            "REVIEWED_REJECTED"
          ],
          "title": "Review Status",
          "type": "string"
